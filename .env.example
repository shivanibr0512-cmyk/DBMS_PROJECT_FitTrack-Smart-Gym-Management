# MySQL: your existing local database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=PUT_YOUR_MYSQL_PASSWORD_HERE
MYSQL_DATABASE=fittrack_db

# MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=fittrack_nosql

# Use a long random secret (at least 32 characters); do not commit it
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
